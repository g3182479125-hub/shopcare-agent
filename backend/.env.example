APP_NAME=ShopCare Agent
APP_ENV=local
SHOPCARE_DB_PATH=./data/shopcare.db
ORDER_CSV_PATH=
USER_CSV_PATH=
AFTERSALES_CSV_PATH=E:/agnet/aftersales_cases.csv

# Text requests use this OpenAI-compatible LLM. Image requests are routed to Kimi only.
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=6

# Optional model profiles. Set provider to deepseek/openai/ollama/etc.
LLM_CHAT_PROVIDER=deepseek
LLM_CHAT_MODEL=deepseek-chat
LLM_REASON_PROVIDER=deepseek
LLM_REASON_MODEL=deepseek-reasoner
LLM_AGENT_PROVIDER=deepseek
LLM_AGENT_MODEL=deepseek-chat

# Optional Ollama OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_REASON_MODEL=deepseek-r1:7b
OLLAMA_AGENT_MODEL=qwen2.5:7b

# Local SQLite prompt cache. Redis semantic cache can be added later without changing callers.
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=86400
LLM_SEMANTIC_CACHE_ENABLED=true
LLM_SEMANTIC_CACHE_THRESHOLD=0.88
LLM_SEMANTIC_CACHE_MAX_CANDIDATES=80

# Optional realtime web search. SerpAPI is used when enabled and configured.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=serpapi
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://serpapi.com/search.json
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_RESULTS=5

# Knowledge RAG vector ranking. auto uses faiss when installed, otherwise local hashing vectors.
KNOWLEDGE_VECTOR_PROVIDER=auto
KNOWLEDGE_VECTOR_DIMENSIONS=384

# Optional GraphRAG / Neo4j. Without Neo4j, ShopCare uses local SQLite graph summaries.
GRAPH_RAG_ENABLED=true
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
GRAPH_QUERY_TIMEOUT_SECONDS=6

AUTH_SECRET=change-me-in-production
AUTH_TOKEN_EXPIRES_SECONDS=604800

ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# Optional image understanding provider. Leave KIMI_API_KEY empty to keep image analysis disabled.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k-vision-preview
KIMI_TIMEOUT_SECONDS=6
